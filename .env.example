# Required for default model routing
ANTHROPIC_API_KEY=           # Claude Sonnet 4.6
GOOGLE_API_KEY=              # Gemini 2.5 Flash

# Optional — enable by changing MODEL_ROUTING in src/lib/models.ts
OPENAI_API_KEY=              # GPT 5.4
MOONSHOT_API_KEY=            # Kimi K2.5
DASHSCOPE_API_KEY=           # Qwen 3.6, Qwen 3.5 small
NVIDIA_API_KEY=              # Nemotron Super

# Data sources (free)
EXA_API_KEY=
NCBI_API_KEY=                # PubMed (free from NCBI)
ONET_USERNAME=               # O*NET (free from services.onetcenter.org)
ONET_PASSWORD=               # O*NET uses Basic Auth
